# Copy this file to .env.local for local development.
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Required: your Google Gemini API key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: comma-separated origins allowed to call /api/generate.
# Leave blank to allow any origin (fine while you're testing).
# Once deployed, set this to your production URL, e.g.
#   https://your-project.vercel.app
ALLOWED_ORIGINS=
